// Prisma schema for YouTube Transcripter
// Works with Vercel Postgres or Neon PostgreSQL.
// Set DATABASE_URL (pooled) and optionally DIRECT_URL (direct) in .env.local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Optional direct connection for migrations (Neon/Vercel).
  // Kept out of required envs so local dev only needs DATABASE_URL.
}

model Document {
  id         String       @id @default(cuid())
  title      String
  // Owner from Neon Auth (Better Auth user id). Required: every folder
  // always belongs to exactly one account — no ownerless rows possible.
  userId     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  transcripts Transcript[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

model Transcript {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  videoId   String
  videoUrl  String
  title     String
  thumbnail String?
  // Full readable text (paragraphs joined). Stored for fast copy/search.
  text      String   @db.Text
  // Raw timestamped captions: [{ text, offset, duration }]
  captions  Json?

  createdAt DateTime @default(now())

  @@unique([documentId, videoId])
  @@index([documentId, createdAt(sort: Desc)])
}
