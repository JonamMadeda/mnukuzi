# Copy to .env.local and fill in values
# Neon — use pooled connection string as DATABASE_URL

DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Neon Auth (Managed Better Auth) — Auth URL from Neon Console → Auth tab
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET="your-secret-at-least-32-characters-long"
# Optional: managed transcript API (Supadata) — immune to YouTube IP blocks.
# Get a free key at https://supadata.ai. When set, it is tried first.
SUPADATA_API_KEY=""
